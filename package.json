{
  "name": "brewme_admin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "public/electron.js",
  "scripts": {
    "dev": "set NODE_ENV=development&&run-p dev:*",
    "dev:routify": "routify",
    "dev:vite": "vite",
    "dev:electron": "electron .",
    "build": "run-s build:*",
    "build:routify": "routify -b",
    "build:vite": "vite build",
    "build:electron": "electron-builder --win --x64"
  },
  "build": {
    "asar": false,
    "appId": "com.example.brewme_admin",
    "productName": "brewme_admin",
    "files": [
      "dist/**/*",
      "public/electron.js",
      "public/favicon.png"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": "dmg"
    },
    "nsis": {
      "oneClick": true,
      "createDesktopShortcut": true
    },
    "directories": {
      "buildResources": "./dist",
      "output": "./brewme_admin_setup",
      "app": "."
    }
  },
  "dependencies": {
    "ag-grid-community": "^28.2.1",
    "ag-grid-enterprise": "^33.0.4",
    "dayjs": "^1.11.13",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.4",
    "jspdf-yworks": "^2.1.1",
    "node-static": "^0.7.11"
  },
  "devDependencies": {
    "@roxi/routify": "^2.18.8",
    "@sveltejs/vite-plugin-svelte": "^1.0.5",
    "svelte": "^3.50.0",
    "svelte-preprocess": "^4.10.7",
    "@types/node-static": "^0",
    "npm-run-all": "^4.1.5",
    "electron": "^35.0.1",
    "electron-builder": "^25.1.8",
    "vite": "^3.1.0"
  }
}
